{
  "name": "music-score",
  "version": "1.1.0",
  "description": "Render music notation and guitar tablature as SVG in the browser from plain JSON, using the Bravura (SMuFL) font. No build step, no dependencies.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "src/",
    "fonts/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/run.js",
    "demo": "python -m http.server 8765 --bind 127.0.0.1"
  },
  "keywords": [
    "music",
    "notation",
    "guitar",
    "tablature",
    "tab",
    "svg",
    "smufl",
    "bravura",
    "sheet-music"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
